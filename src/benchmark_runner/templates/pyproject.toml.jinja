[project]
name = "{{ benchmark_name }}-runner"
version = "0.1.0"
description = "{{ benchmark_camel }} benchmark runner."
requires-python = ">=3.12"

dependencies = [
    "create-benchmark-runner @ git+ssh://git@github.com/vals-ai/create-benchmark-runner.git@main",
    # Add your benchmark-specific deps (agent submodule, datasets, etc.) below.
]

[project.scripts]
{{ benchmark_name }}-runner = "runner.cli:cli"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["runner"]

[tool.hatch.metadata]
allow-direct-references = true

[dependency-groups]
dev = [
    "pytest>=8.0",
    "ruff>=0.15",
]
