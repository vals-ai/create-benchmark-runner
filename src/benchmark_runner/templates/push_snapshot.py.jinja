#!/usr/bin/env python3
"""Build and push a Daytona snapshot of the {{ benchmark_name }}-runner image."""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path

from daytona import CreateSnapshotParams, Daytona, DaytonaConfig, Image
from daytona.common.sandbox import Resources

DEFAULT_SNAPSHOT_PREFIX = "{{ benchmark_name }}-runner-pkg"
DEFAULT_DOCKERFILE = Path(__file__).parent / "Dockerfile"
SNAPSHOT_RESOURCES = Resources(cpu=1, memory=2, disk=10)
SAFE_SNAPSHOT_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")


def load_daytona_config() -> DaytonaConfig:
    missing = [
        name
        for name in ("DAYTONA_API_KEY", "DAYTONA_API_URL", "DAYTONA_TARGET")
        if not os.environ.get(name)
    ]
    if missing:
        raise ValueError(
            "missing required Daytona environment variables: " + ", ".join(missing)
        )

    return DaytonaConfig(
        api_key=os.environ["DAYTONA_API_KEY"],
        api_url=os.environ["DAYTONA_API_URL"],
        target=os.environ["DAYTONA_TARGET"],
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create a Daytona snapshot from the {{ benchmark_name }} runner Dockerfile."
    )
    parser.add_argument("--dockerfile", type=Path, default=DEFAULT_DOCKERFILE)
    parser.add_argument(
        "--snapshot-name",
        default=os.environ.get("DAYTONA_SNAPSHOT_NAME", ""),
    )
    parser.add_argument(
        "--snapshot-prefix",
        default=os.environ.get("DAYTONA_SNAPSHOT_PREFIX", DEFAULT_SNAPSHOT_PREFIX),
    )
    parser.add_argument(
        "--snapshot-version",
        default=os.environ.get("DAYTONA_SNAPSHOT_VERSION", ""),
    )
    parser.add_argument(
        "--generation-version",
        default=os.environ.get("{{ benchmark_upper }}_GENERATION_VERSION", ""),
    )
    return parser.parse_args()


def validate_snapshot_name(name: str) -> str:
    if not SAFE_SNAPSHOT_NAME.fullmatch(name):
        raise ValueError(
            "snapshot names may only contain letters, numbers, dots, underscores, and hyphens"
        )
    return name


def resolve_snapshot_name(args: argparse.Namespace) -> str:
    if args.snapshot_name:
        return validate_snapshot_name(args.snapshot_name)
    prefix = validate_snapshot_name(args.snapshot_prefix)
    if not args.snapshot_version:
        return prefix
    version = validate_snapshot_name(args.snapshot_version)
    return f"{prefix}-{version}"


def resolve_snapshot_image(args: argparse.Namespace) -> Image:
    image = Image.from_dockerfile(args.dockerfile)
    if args.generation_version:
        image.env({"{{ benchmark_upper }}_GENERATION_VERSION": args.generation_version})
    return image


def main() -> int:
    args = parse_args()
    snapshot_name = resolve_snapshot_name(args)
    image = resolve_snapshot_image(args)

    daytona = Daytona(load_daytona_config())

    print(f"creating snapshot {snapshot_name} from {args.dockerfile}...")
    snapshot = daytona.snapshot.create(
        CreateSnapshotParams(
            name=snapshot_name,
            image=image,
            resources=SNAPSHOT_RESOURCES,
        ),
        on_logs=lambda chunk: print(chunk, file=sys.stderr, flush=True),
        timeout=0,
    )
    print(f"done: {snapshot}")
    print(snapshot_name)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
